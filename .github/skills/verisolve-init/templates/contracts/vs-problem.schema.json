{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verisolve.dev/contracts/vs-problem.schema.json",
  "title": "VSProblem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_id",
    "source",
    "raw",
    "category",
    "severity",
    "priority_score",
    "signature",
    "created_at",
    "metadata"
  ],
  "properties": {
    "problem_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "type": "string", "minLength": 1 },
    "raw": { "type": "object", "additionalProperties": true },
    "category": { "type": ["string", "null"] },
    "severity": { "enum": ["critical", "high", "medium", "low", null] },
    "priority_score": { "type": ["number", "null"] },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "features", "location"],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 64 }
        },
        "features": { "type": "object", "additionalProperties": true },
        "location": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
