{
  "max_parallel_triage": 8,
  "max_parallel_resolution": 8,
  "retry_per_bug": 1,
  "infra_retry": 3,
  "ingest_seq": {
    "field": "ingest_seq",
    "assignment": "strictly_increasing_per_batch_at_fetch",
    "tie_breaker": "ascending"
