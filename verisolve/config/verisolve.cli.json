{
  "runtime": "PowerShell 7",
  "entry_script": "scripts/verisolve.ps1",
  "command_templates": {
    "run": "run --backlog {backlog}",
    "status": "status --run {run_id}",
    "report": "report --run {run_id} --format {format}",
    "kb_query": "kb query --category {category} --signature {signature}",
    "kb_stats": "kb stats",
    "kb_rebuild": "kb rebuild"
  },
  "backlog_endpoints": {
    "example": "builtin:example"
  },
  "run_store": "data/runs",
  "lock_file": "data/verisolve.lock",
  "config_files": {
    "system": "verisolve.system.json",
    "agents": "verisolve.agents.json",
    "categories": "verisolve.categories.json",
    "verification": "verisolve.verification.json",
    "knowledge_base": "verisolve.knowledge_base.json"
  },
  "reports": {
    "markdown_filename": "report.md",
    "json_filename": "report.json"
  }
}
