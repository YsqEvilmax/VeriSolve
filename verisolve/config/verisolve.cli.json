{
  "entry_script": "scripts/verisolve.ps1",
  "agent_runtime": {
    "command_env": "VERISOLVE_AGENT_RUNTIME",
    "workflow_option": "--workflow",
    "argument_separator": "--",
    "workflow_map": {
      "run": "workflows/run-pipeline.workflow.md",
      "status": "workflows/run-pipeline.workflow.md",
      "report": "workflows/run-pipeline.workflow.md",
      "kb": "workflows/run-pipeline.workflow.md"
    }
  },
  "command_templates": {
    "run": "run --backlog {backlog}",
    "status": "status --run {run_id}",
    "report": "report --run {run_id} --format {format}",
    "kb_query": "kb query --category {category} --signature {signature}",
    "kb_stats": "kb stats",
    "kb_rebuild": "kb rebuild"
  },
  "backlog_endpoints": {
    "example": "builtin:example"
  },
  "problem_sources": {
    "example": {
      "command": null,
      "arguments": []
    }
  },
  "example_adapter": {
    "backlog_response": {
      "problems": [],
      "next_cursor": null
    },
    "oracle_verdict": {
      "ok": false,
      "fail_category": "unknown",
      "evidence": {
        "top_errors": [],
        "signals": {},
        "artifacts": {}
      },
      "verdict_at": "2000-01-01T00:00:00Z"
    }
  },
  "executor": {
    "command": null,
    "arguments": []
  },
  "oracle": {
    "command": null,
    "arguments": []
  },
  "run_store": "data/runs",
  "lock_file": "data/verisolve.lock",
  "config_files": {
    "system": "verisolve.system.json",
    "agents": "verisolve.agents.json",
    "categories": "verisolve.categories.json",
    "verification": "verisolve.verification.json",
    "knowledge_base": "verisolve.knowledge_base.json"
  },
  "reports": {
    "markdown_filename": "report.md",
    "json_filename": "report.json"
  }
}
