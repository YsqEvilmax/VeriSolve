{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verisolve.dev/contracts/change.schema.json",
  "title": "VSChange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "problem_id",
    "diff",
    "summary",
    "targets",
    "playbook_ref",
    "change_at"
  ],
  "properties": {
    "change_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "problem_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "diff": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1 }
    },
    "playbook_ref": { "type": ["string", "null"] },
    "change_at": { "type": "string", "format": "date-time" }
  }
}
